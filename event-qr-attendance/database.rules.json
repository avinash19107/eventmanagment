{
  "rules": {
    "events": {
      ".read": true,
      ".write": true,
      ".indexOn": ["startDate", "status", "category", "organizationId"],
      "$eventId": {
        ".validate": "newData.hasChildren(['id', 'title', 'category', 'startDate', 'venueName'])"
      }
    },
    "users": {
      ".read": true,
      ".write": true,
      ".indexOn": ["email", "registrationNumber", "role", "status"],
      "$userId": {
        ".validate": "newData.hasChildren(['id', 'email', 'name', 'role'])"
      }
    },
    "registrations": {
      ".read": true,
      ".write": true,
      ".indexOn": ["eventId", "attendeeEmail", "reference", "registrationNumber", "status"],
      "$registrationId": {
        ".validate": "newData.hasChildren(['eventId', 'attendeeEmail', 'reference'])"
      }
    },
    "attendance": {
      ".read": true,
      ".write": true,
      ".indexOn": ["eventId", "registrationId", "attendeeEmail"]
    },
    "winners": {
      ".read": true,
      ".write": true
    },
    "visitors": {
      ".read": true,
      ".write": true,
      ".indexOn": ["timestamp", "page"]
    },
    "analytics": {
      ".read": true,
      ".write": true,
      ".indexOn": ["eventId", "timestamp"]
    },
    "audit_logs": {
      ".read": true,
      ".indexOn": ["entityId", "actorId", "action", "timestamp"],
      "$logId": {
        ".write": "!data.exists()"
      }
    }
  }
}
