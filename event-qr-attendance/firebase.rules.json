{
  "rules": {

    "events": {
      ".read": "auth != null",
      "$eventId": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'organizer'",
        ".validate": "newData.hasChildren(['id', 'title', 'category', 'startDate', 'venueName'])",

        "live_checkins": {
          ".write": "auth != null"
        },

        "hourly_distribution": {
          ".write": "auth != null"
        },

        "analytics": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      }
    },

    "users": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'organizer'",
      "$userId": {
        ".read": "auth != null && (auth.uid === $userId || root.child('users').child(auth.uid).child('role').val() === 'organizer')",
        ".write": "auth != null && (auth.uid === $userId || root.child('users').child(auth.uid).child('role').val() === 'organizer')",
        ".validate": "newData.hasChildren(['id', 'email', 'name', 'role'])",
        "role": {
          ".validate": "root.child('users').child(auth.uid).child('role').val() === 'organizer' || !data.exists()"
        }
      }
    },

    "registrations": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'organizer'",
      "$registrationId": {
        ".read": "auth != null && (data.child('attendeeEmail').val() === auth.token.email || root.child('users').child(auth.uid).child('role').val() === 'organizer')",
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['eventId', 'attendeeEmail', 'reference']) || !newData.exists()"
      }
    },

    "visitors": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'organizer'",
      ".write": "auth != null"
    },

    "analytics": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'organizer'",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'organizer'"
    },

    "winners": {
      ".read": "auth != null",
      "$eventId": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'organizer'"
      }
    },

    "audit_logs": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'organizer'",
      "$logId": {
        ".write": "auth != null && !data.exists()"
      }
    }

  }
}
